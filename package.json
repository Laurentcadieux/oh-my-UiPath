{
  "name": "oh-my-uipath",
  "version": "1.0.0",
  "description": "Multi-agent orchestration for the UiPath platform, powered by the uip CLI and the 27 UiPath skills.",
  "license": "MIT",
  "author": "Laurent Cadieux <laurent@cadieux.dev>",
  "type": "commonjs",
  "main": "./dist/index.js",
  "bin": {
    "omu": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "test": "node --test dist/**/*.test.js || tsc --noEmit",
    "prepublishOnly": "tsc -p tsconfig.json && npm test",
    "publish": "npm publish --access public"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "uipath",
    "orchestration",
    "multi-agent",
    "automation",
    "uip",
    "cli",
    "sdd"
  ]
}
