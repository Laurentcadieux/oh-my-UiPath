{
  "name": "oh-my-uipath-h",
  "version": "1.8.2",
  "description": "Multi-agent orchestration for the UiPath platform — chains uip CLI skills into a reliable SDD-to-deploy pipeline with stop-on-failure, skill status gating, review, and diagnostics. Research only — not affiliated with UiPath.",
  "license": "MIT",
  "author": "Laurent Cadieux <laurent@cadieux.dev>",
  "type": "commonjs",
  "main": "./dist/index.js",
  "bin": {
    "omu-h": "./dist/cli.js"
  },
  "files": [
    ".claude-plugin",
    "dist",
    "docs",
    "templates",
    "AGENTS.md",
    "README.md",
    "LICENSE",
    "hooks",
    "assets"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "test": "tsc -p tsconfig.json && node --test dist/test/*.test.js",
    "prepublishOnly": "tsc -p tsconfig.json && npm test",
    "publish": "npm publish --access public"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "uipath",
    "orchestration",
    "multi-agent",
    "automation",
    "uip",
    "cli",
    "sdd"
  ]
}
